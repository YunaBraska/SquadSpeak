--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -11,6 +11,32 @@

 # Get the repo version and CMake policy details
 include(.cmake.conf)
+
+# Rebuild Network with the installed Core ABI and configuration, without
+# configuring or producing a replacement Core library.
+if(SQUADSPEAK_NETWORK_ONLY)
+    project(QtNetwork VERSION "${QT_REPO_MODULE_VERSION}" LANGUAGES CXX C)
+    find_package(Qt6 ${PROJECT_VERSION} EXACT CONFIG REQUIRED COMPONENTS BuildInternals)
+    qt_internal_project_setup()
+    find_package(Qt6 ${PROJECT_VERSION} EXACT CONFIG REQUIRED COMPONENTS Core CorePrivate)
+    qt_build_repo_begin()
+    if(QT_FEATURE_system_zlib)
+        find_package(WrapZLIB REQUIRED)
+    endif()
+    if(QT_FEATURE_zstd)
+        find_package(WrapZSTD REQUIRED)
+    endif()
+    if(QT_FEATURE_openssl)
+        find_package(WrapOpenSSLHeaders REQUIRED)
+    endif()
+    if(QT_FEATURE_openssl_linked)
+        find_package(WrapOpenSSL REQUIRED)
+    endif()
+    qt_feature_evaluate_features("${CMAKE_CURRENT_SOURCE_DIR}/src/network/configure.cmake")
+    add_subdirectory(src/network)
+    qt_build_repo_end()
+    return()
+endif()

 include(${CMAKE_CURRENT_SOURCE_DIR}/cmake/QtBaseHelpers.cmake)

