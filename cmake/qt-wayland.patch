+bool QPipeWireCaptureHelper::subscribeToRequestResponse(const QString &handleToken)
+{
+    Q_ASSERT(m_pendingRequestPath.isEmpty());
+    auto bus = QDBusConnection::sessionBus();
+    QString sender = bus.baseService();
+    if (sender.startsWith(u':')) sender.remove(0, 1);
+    sender.replace(u'.', u'_');
+    const auto path = u"/org/freedesktop/portal/desktop/request/%1/%2"_s.arg(sender, handleToken);
+    if (!bus.connect(u"org.freedesktop.portal.Desktop"_s, path,
+                     u"org.freedesktop.portal.Request"_s, u"Response"_s,
+                     this, SLOT(gotRequestResponse(uint,QVariantMap,QDBusMessage)))) {
+        destroy();
+        updateError(QPlatformSurfaceCapture::InternalError,
+                    u"Failed to subscribe to portal request response"_s);
+        return false;
+    }
+    m_pendingRequestPath = path;
+    return true;
+}
+
+void QPipeWireCaptureHelper::unsubscribeFromRequestResponse()
+{
+    if (m_pendingRequestPath.isEmpty()) return;
+    QDBusConnection::sessionBus().disconnect(
+            u"org.freedesktop.portal.Desktop"_s, m_pendingRequestPath,
+            u"org.freedesktop.portal.Request"_s, u"Response"_s,
+            this, SLOT(gotRequestResponse(uint,QVariantMap,QDBusMessage)));
+    m_pendingRequestPath.clear();
+}
+
+void QPipeWireCaptureHelper::closeSession(bool closeRemote)
+{
+    if (m_sessionHandle.isEmpty()) return;
+    auto bus = QDBusConnection::sessionBus();
+    bus.disconnect(u"org.freedesktop.portal.Desktop"_s, m_sessionHandle,
+                   u"org.freedesktop.portal.Session"_s, u"Closed"_s,
+                   this, SLOT(sessionClosed(QVariantMap,QDBusMessage)));
+    if (closeRemote) {
+        auto close = QDBusMessage::createMethodCall(u"org.freedesktop.portal.Desktop"_s,
+                m_sessionHandle, u"org.freedesktop.portal.Session"_s, u"Close"_s);
+        bus.asyncCall(close);
+    }
+    m_sessionHandle.clear();
+}
+
+void QPipeWireCaptureHelper::sessionClosed(const QVariantMap &, const QDBusMessage &message)
+{
+    if (m_sessionHandle.isEmpty() || message.path() != m_sessionHandle) return;
+    closeSession(false);
+    destroy();
+    updateError(QPlatformSurfaceCapture::InternalError,
+                u"PipeWire screen capture session was closed"_s);
 }

